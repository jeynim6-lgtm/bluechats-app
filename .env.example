# ─────────────────────────────────────────────────────────────────────────────
#  Blue Chats — server configuration
#  Copy to `.env` for local development, or add these as secrets/environment
#  variables in your hosting provider (AI Studio "Secrets", Cloud Run, etc.).
#  Nothing below is ever sent to the browser except the FIREBASE_* web config.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase web app (REQUIRED) ──────────────────────────────────────────────
# EASIEST: paste the config snippet into src/config/firebase.ts instead (it's public, safe to commit).
# Or set FIREBASE_WEB_CONFIG to the whole snippet, or the individual variables below.
# Firebase console → Project settings → General → Your apps → Web app → SDK config
FIREBASE_WEB_CONFIG=""
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""          # e.g. your-project.firebaseapp.com
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""               # e.g. 1:1234567890:web:abc123def456
FIREBASE_STORAGE_BUCKET=""       # optional
FIREBASE_MESSAGING_SENDER_ID=""  # optional
#
# Also in the Firebase console:
#   • Authentication → Sign-in method → enable "Phone"
#   • Authentication → Settings → Authorized domains → add your site's domain
#   • Deploy security rules + indexes:  npm run deploy:rules
#   • (Recommended) Firestore → TTL policies → collection "statuses", field "expiresAt"

# ── Firebase Admin (recommended) ─────────────────────────────────────────────
# Service account JSON (raw JSON or base64) — needed to assign the CEO/admin claim.
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=""
# Alternatively: GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── CEO / admin dashboard ────────────────────────────────────────────────────
# Accounts promoted to CEO the first time they sign in (comma-separated, E.164 format).
CEO_PHONE_NUMBERS=""             # e.g. +27821234567,+27831234567
CEO_EMAILS=""                    # only used for accounts with a verified email

# ── Bunny.net media storage (REQUIRED for photos, voice notes, video) ────────
# Bunny dashboard → Storage → your zone → FTP & API Access
BUNNY_STORAGE_ZONE=""            # storage zone name
BUNNY_STORAGE_API_KEY=""         # the zone's *Password* (not your account API key)
BUNNY_STORAGE_REGION=""          # MUST match the zone's main region: de (default) | uk | ny | la | sg | se | br | jh | syd
# BUNNY_STORAGE_HOST=""          # or set the exact host, e.g. jh.storage.bunnycdn.com
# Pull zone linked to the storage zone — media is then served straight from the CDN.
# Leave empty to stream files through this server instead.
BUNNY_CDN_URL=""                 # e.g. https://bluechats.b-cdn.net
BUNNY_ACCOUNT_API_KEY=""         # optional: purges the CDN cache when files are deleted

# ── Calls: TURN relay (strongly recommended for production) ──────────────────
# Without TURN, calls between some mobile networks / corporate Wi-Fi cannot connect.
# Option A — static credentials (e.g. Metered, Twilio, Xirsys, your own coturn):
TURN_URLS=""                     # e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_USERNAME=""
TURN_CREDENTIAL=""
# Option B — coturn "use-auth-secret" (time-limited credentials minted per user):
TURN_SHARED_SECRET=""
# Option C — Cloudflare Calls TURN:
CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_API_TOKEN=""
# STUN_URLS="stun:stun.l.google.com:19302"

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=3000

# ── Local development against the Firebase emulators (optional) ─────────────
# npm run emulators   (in one terminal)   then   npm run dev:emulators
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
