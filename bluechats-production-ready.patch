+  { id: 'sunset', name: 'Sunset', brand: '#E8752B', strong: '#C85A14', soft: '#F29F66' },
+];
+
+export interface SponsoredCard {
+  id: string;
+  sponsor: string;
+  text: string;
+  cta: string;
+  /** Opened when the CTA is tapped. Cards without a URL show no button. */
